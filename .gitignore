# Dependencies
node_modules/

# Build artifacts
# The single-file game build is generated into dist/ by scripts/build-standalone.mjs;
# the dev-tools Vite build goes to dev_tools/ui/dist/. Neither is source.
dist/
dev_tools/ui/dist/

# Local scratch, probe scripts and logs
.scratch/
*.log

# QA / probe artifacts (README screenshots are explicitly kept below)
shots/*
!shots/01-menu.png
!shots/02-gameplay.png
!shots/03-action.png
!shots/04-victory.png
!shots/05-death.png
!shots/06-menu-720.png
!shots/07-gameplay-720.png
!shots/fps-game-1600x900.png

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
